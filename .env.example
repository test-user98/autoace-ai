# Copy to app/.env.local for local dashboard development. Never commit real values.
# On Vercel these are Project Settings -> Environment Variables.

# --- Dashboard login (Vercel) ---------------------------------------------
# The single credential pair that gates the dashboard.
DASHBOARD_USER=autoace
DASHBOARD_PASSWORD=change-me-to-something-long

# HMAC key for the session cookie. Must be >= 16 chars; generate with:
#   openssl rand -hex 32
AUTH_SECRET=

# --- Vercel Blob (Vercel) --------------------------------------------------
# Set automatically when you connect a Blob store to the project. Only needed
# by hand for local dev (`vercel env pull` writes it for you).
BLOB_READ_WRITE_TOKEN=

# --- Modal compute plane (Vercel) -----------------------------------------
# Base URL printed by `modal deploy modal_app.py` for the `web` function.
# No trailing slash needed; one is stripped anyway.
MODAL_ENDPOINT_URL=https://<workspace>--autoace-voice-trial-web.modal.run

# Shared secret between the dashboard and the Modal endpoint. Must match the
# MODAL_AUTH_TOKEN inside the Modal secret named `autoace-voice-trial`.
#   openssl rand -hex 32
MODAL_AUTH_TOKEN=

# --- Modal secret `autoace-voice-trial` (Modal, not Vercel) ---------------
# Created with:
#   modal secret create autoace-voice-trial MODAL_AUTH_TOKEN=<same value as above>
# Phase 2 only (ASR/diarization models): add HF_TOKEN=<hf token> to that same
# Modal secret. Not required for the CPU pipeline shipping today.
